    <!-- ===== MESSAGES ===== -->

    <!-- 1. User opens shop page -->
    <mxCell id="m1" value="1. Navigate to /shop/[productId]" style="endArrow=open;endFill=0;html=1;fontSize=11;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;strokeColor=#333333;" edge="1" parent="1">
      <mxGeometry x="140" y="195" relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="200" /><mxPoint x="440" y="200" /></Array></mxGeometry>
    </mxCell>

    <!-- 2. Shop page renders product -->
    <mxCell id="m2" value="2. Render ProductCard (title, price, buyForm)" style="endArrow=open;endFill=0;html=1;fontSize=11;strokeColor=#82b366;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="250" /><mxPoint x="140" y="250" /></Array></mxGeometry>
    </mxCell>

    <!-- 3. User fills form -->
    <mxCell id="m3" value="3. Fill checkout form (name, email, phone)" style="endArrow=open;endFill=0;html=1;fontSize=11;strokeColor=#333333;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="310" /><mxPoint x="440" y="310" /></Array></mxGeometry>
    </mxCell>

    <!-- 4. User submits -->
    <mxCell id="m4" value="4. Submit form (click Buy)" style="endArrow=open;endFill=0;html=1;fontSize=11;strokeColor=#333333;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="360" /><mxPoint x="440" y="360" /></Array></mxGeometry>
    </mxCell>

    <!-- 5. ShopPage → API POST -->
    <mxCell id="m5" value="5. POST /api/shop/orders&#xa;   { buyerName, buyerEmail, buyerPhone, productId, productTitle, price }" style="endArrow=open;endFill=0;html=1;fontSize=11;strokeColor=#d6b656;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="400" /><mxPoint x="740" y="400" /></Array></mxGeometry>
    </mxCell>

    <!-- 6. API validates Zod -->
    <mxCell id="m6_note" value="6. Zod validation + generate orderNumber" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;dashed=1;rounded=1;" vertex="1" parent="1">
      <mxGeometry x="755" y="440" width="260" height="30" as="geometry" />
    </mxCell>

    <!-- 7. API → DB create order -->
    <mxCell id="m7" value="7. db.order.create({ ...order, items: [orderItem] })" style="endArrow=open;endFill=0;html=1;fontSize=11;strokeColor=#9673a6;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="500" /><mxPoint x="1040" y="500" /></Array></mxGeometry>
    </mxCell>

    <!-- 8. DB returns order -->
    <mxCell id="m8" value="8. Created Order (with items)" style="endArrow=open;endFill=0;html=1;fontSize=11;strokeColor=#9673a6;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="570" /><mxPoint x="740" y="570" /></Array></mxGeometry>
    </mxCell>

    <!-- 9. API → ShopPage 201 -->
    <mxCell id="m9" value="9. Return 201 { ok: true, order }" style="endArrow=open;endFill=0;html=1;fontSize=11;strokeColor=#d6b656;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="740" y="640" /><mxPoint x="440" y="640" /></Array></mxGeometry>
    </mxCell>

    <!-- 10. ShopPage → User success -->
    <mxCell id="m10" value="10. Show order confirmation modal&#xa;    (orderNumber, buyerName, total)" style="endArrow=open;endFill=0;html=1;fontSize=11;strokeColor=#82b366;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="710" /><mxPoint x="140" y="710" /></Array></mxGeometry>
