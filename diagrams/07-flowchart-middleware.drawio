<mxfile host="app.diagrams.net" modified="2026-04-27" version="21.0.0">
  <diagram id="middleware-flow" name="Middleware Flowchart">
<mxGraphModel dx="1422" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1169" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- TITLE -->
    <mxCell id="title" value="Admin Route Protection — Next.js Middleware Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="150" y="20" width="800" height="40" as="geometry" />
    </mxCell>

    <!-- START -->
    <mxCell id="start" value="Incoming Request" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="440" y="80" width="160" height="50" as="geometry" />
    </mxCell>

    <!-- matcher check -->
    <mxCell id="note_matcher" value="Middleware matcher: /admin/:path*" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
      <mxGeometry x="660" y="88" width="220" height="35" as="geometry" />
    </mxCell>

    <!-- Is /admin path? -->
    <mxCell id="d1" value="pathname.startsWith(&apos;/admin&apos;) ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="400" y="170" width="240" height="70" as="geometry" />
    </mxCell>

    <!-- Not admin → pass through -->
    <mxCell id="s_pass1" value="NextResponse.next()&#xa;(Non-admin route, no auth needed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="100" y="185" width="230" height="50" as="geometry" />
    </mxCell>

    <!-- Is /admin/login? -->
    <mxCell id="d2" value="pathname.startsWith(&apos;/admin/login&apos;) ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="400" y="290" width="240" height="70" as="geometry" />
    </mxCell>

    <!-- Login page → pass through -->
    <mxCell id="s_pass2" value="NextResponse.next()&#xa;(Login page is always public)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="700" y="305" width="230" height="50" as="geometry" />
    </mxCell>

    <!-- Has admin_token cookie? -->
    <mxCell id="d3" value="Has admin_token cookie ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="400" y="410" width="240" height="70" as="geometry" />
    </mxCell>

    <!-- No cookie → redirect -->
    <mxCell id="e_nocookie" value="Redirect to /admin/login&#xa;(No token present)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="100" y="425" width="230" height="50" as="geometry" />
    </mxCell>

    <!-- jwtVerify -->
    <mxCell id="s_verify" value="await jwtVerify(token, HS256_secret)&#xa;(Using jose library)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="400" y="530" width="240" height="60" as="geometry" />
    </mxCell>

    <!-- Token valid? -->
    <mxCell id="d4" value="Token valid &amp; not expired ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="400" y="640" width="240" height="70" as="geometry" />
    </mxCell>

    <!-- Invalid token → delete cookie + redirect -->
    <mxCell id="e_invalid" value="Delete admin_token cookie&#xa;Redirect to /admin/login" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="700" y="655" width="230" height="50" as="geometry" />
    </mxCell>

    <!-- Valid → pass through -->
    <mxCell id="s_allow" value="NextResponse.next()&#xa;(Admin authenticated — allow access)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="400" y="770" width="240" height="60" as="geometry" />
    </mxCell>

    <!-- END -->
    <mxCell id="end" value="Request handled" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1">
      <mxGeometry x="440" y="880" width="160" height="50" as="geometry" />
    </mxCell>

    <!-- ===== ARROWS ===== -->
    <mxCell id="a1" style="rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="start" target="d1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

    <mxCell id="a2" value="No (not /admin)" style="rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontStyle=1;" edge="1" source="d1" target="s_pass1" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a3" value="Yes" style="rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;" edge="1" source="d1" target="d2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

    <mxCell id="a4" value="Yes (/admin/login)" style="rounded=0;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontStyle=1;" edge="1" source="d2" target="s_pass2" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a5" value="No (other /admin/*)" style="rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;" edge="1" source="d2" target="d3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

    <mxCell id="a6" value="No (no cookie)" style="rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontStyle=1;" edge="1" source="d3" target="e_nocookie" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a7" value="Yes" style="rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;" edge="1" source="d3" target="s_verify" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

    <mxCell id="a8" style="rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="s_verify" target="d4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

    <mxCell id="a9" value="Invalid / Expired" style="rounded=0;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontStyle=1;" edge="1" source="d4" target="e_invalid" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a10" value="Valid" style="rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontStyle=1;" edge="1" source="d4" target="s_allow" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

    <mxCell id="a11" style="rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="s_allow" target="end" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

    <!-- All pass-through nodes connect to end -->
    <mxCell id="a12" style="rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" source="s_pass1" target="end" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="930" /></Array></mxGeometry>
    </mxCell>
    <mxCell id="a13" style="rounded=0;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" source="s_pass2" target="end" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="930" /></Array></mxGeometry>
    </mxCell>
    <!-- error redirects → not to end (they redirect browser) -->
    <mxCell id="a14_note" value="(redirects browser to /admin/login)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="100" y="480" width="220" height="20" as="geometry" />
    </mxCell>
    <mxCell id="a15_note" value="(redirects browser to /admin/login)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;" vertex="1" parent="1">
      <mxGeometry x="700" y="710" width="230" height="20" as="geometry" />
    </mxCell>

    <!-- Protected pages list -->
    <mxCell id="pages_note" value="Protected /admin pages:&#xa;• /admin (dashboard)&#xa;• /admin/orders&#xa;• /admin/products&#xa;• /admin/analytics" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1">
      <mxGeometry x="80" y="640" width="200" height="120" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>
  </diagram>
</mxfile>
