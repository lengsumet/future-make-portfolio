    <!-- ===== MESSAGES ===== -->

    <!-- 1. Page load initializes hook -->
    <mxCell id="m1" value="1. Page mounts / user navigates" style="endArrow=open;endFill=0;html=1;fontSize=11;strokeColor=#333333;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="200" /><mxPoint x="420" y="200" /></Array></mxGeometry>
    </mxCell>

    <!-- 2. Hook generates sessionId -->
    <mxCell id="m2_note" value="2. Generate/retrieve sessionId (localStorage)" style="text;html=1;strokeColor=none;fillColor=#e8f4f8;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;rounded=1;" vertex="1" parent="1">
      <mxGeometry x="438" y="240" width="270" height="25" as="geometry" />
    </mxCell>

    <!-- 3. track page_view event -->
    <mxCell id="m3" value="3. trackEvent({ eventType: &apos;page_view&apos;, page: &apos;/shop&apos; })" style="endArrow=open;endFill=0;html=1;fontSize=11;strokeColor=#333333;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="310" /><mxPoint x="420" y="310" /></Array></mxGeometry>
    </mxCell>

    <!-- 4. POST /api/track -->
    <mxCell id="m4" value="4. POST /api/track&#xa;   { sessionId, eventType: &apos;page_view&apos;, page: &apos;/shop&apos;, metadata: {} }" style="endArrow=open;endFill=0;html=1;fontSize=11;strokeColor=#d6b656;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="370" /><mxPoint x="700" y="370" /></Array></mxGeometry>
    </mxCell>

    <!-- 5. Validate fields -->
    <mxCell id="m5_note" value="5. Validate: sessionId, eventType, page present" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=10;rounded=1;" vertex="1" parent="1">
      <mxGeometry x="718" y="400" width="280" height="25" as="geometry" />
    </mxCell>

    <!-- 6. DB create PageEvent -->
    <mxCell id="m6" value="6. db.pageEvent.create({&#xa;   sessionId, eventType, page, element,&#xa;   metadata (JSON), userAgent })" style="endArrow=open;endFill=0;html=1;fontSize=11;strokeColor=#9673a6;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="480" /><mxPoint x="980" y="480" /></Array></mxGeometry>
    </mxCell>

    <!-- 7. DB returns created event -->
    <mxCell id="m7" value="7. Created PageEvent { id, createdAt }" style="endArrow=open;endFill=0;html=1;fontSize=11;strokeColor=#9673a6;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="560" /><mxPoint x="700" y="560" /></Array></mxGeometry>
    </mxCell>

    <!-- 8. API returns 200 -->
    <mxCell id="m8" value="8. Return 200 { ok: true, id }" style="endArrow=open;endFill=0;html=1;fontSize=11;strokeColor=#d6b656;dashed=1;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="620" /><mxPoint x="420" y="620" /></Array></mxGeometry>
    </mxCell>

    <!-- 9. User clicks something -->
    <mxCell id="m9" value="9. User clicks element (e.g., Buy button)" style="endArrow=open;endFill=0;html=1;fontSize=11;strokeColor=#333333;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="680" /><mxPoint x="420" y="680" /></Array></mxGeometry>
    </mxCell>

    <!-- 10. POST click event -->
    <mxCell id="m10" value="10. POST /api/track&#xa;    { eventType: &apos;click&apos;, element: &apos;buy-btn&apos;, page: &apos;/shop/[id]&apos; }" style="endArrow=open;endFill=0;html=1;fontSize=11;strokeColor=#d6b656;" edge="1" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="420" y="730" /><mxPoint x="700" y="730" /></Array></mxGeometry>
    </mxCell>

    <!-- (same flow repeats...) -->
    <mxCell id="repeat_note" value="→ Same DB write flow repeats for every tracked event" style="text;html=1;strokeColor=none;fillColor=#e8f4f8;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;rounded=1;" vertex="1" parent="1">
