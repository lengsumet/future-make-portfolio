    <mxCell id="a10" style="rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="s5" target="end" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="a11" style="rounded=0;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" source="e1" target="end" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="405" /><mxPoint x="1010" y="1015" /></Array></mxGeometry>
    </mxCell>
    <mxCell id="a12" style="rounded=0;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" source="e2" target="end" parent="1">
      <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="792" /><mxPoint x="1010" y="1015" /></Array></mxGeometry>
    </mxCell>

    <!-- ADMIN GET / PATCH section -->
    <mxCell id="sep" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#999999;" edge="1" parent="1">
      <mxGeometry x="80" y="1060" width="980" height="10" as="geometry"><Array as="points"><mxPoint x="80" y="1060" /><mxPoint x="1060" y="1060" /></Array></mxGeometry>
    </mxCell>
    <mxCell id="admin_title" value="Admin-only Endpoints (require valid admin_token cookie)" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="200" y="1070" width="600" height="30" as="geometry" />
    </mxCell>
    <mxCell id="get_flow" value="GET /api/shop/orders&#xa;1. requireAdmin() — verify JWT cookie&#xa;2. db.order.findMany({ include: items, orderBy: createdAt desc, take: 100 })&#xa;3. Return 200 [Order[]]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;" vertex="1" parent="1">
      <mxGeometry x="80" y="1115" width="450" height="100" as="geometry" />
    </mxCell>
    <mxCell id="patch_flow" value="PATCH /api/shop/orders&#xa;1. requireAdmin() — verify JWT cookie&#xa;2. Parse { orderId, status } from body&#xa;3. db.order.update({ status, paidAt if status=&apos;paid&apos; })&#xa;4. Return 200 { ok: true, order }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;" vertex="1" parent="1">
      <mxGeometry x="570" y="1115" width="450" height="100" as="geometry" />
    </mxCell>

  </root>
